# HoneyChain — FastAPI backend environment

# Runtime environment: development | production (unknown values are rejected)
API_ENV=development

# Supabase PostgreSQL (system of record). Server-side ONLY. Never in Flutter.
SUPABASE_URL=https://hhxwhopaazqjdlreqhkf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT signing. REQUIRED in production. For local development, leave empty to
# receive a fresh ephemeral secret on each backend process start.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma separated). Mobile apps do not need CORS; only web dashboards do.
CORS_ORIGINS=

# Ledger + AI adapters: simulated | fabric ; risk_engine | ai
BLOCKCHAIN_ADAPTER=simulated
AI_ADAPTER=risk_engine

# Local/demo authentication password. Never commit a real value.
# DEMO_PASSWORD=

# Ask My Bee — Gemini voice assistant. GEMINI_API_KEY lives only in this file /
# the server environment; it must NEVER be compiled into the Flutter app or
# committed. Without a key the assistant answers a graceful "not configured".
AI_ASSISTANT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_RATE_LIMIT_PER_MINUTE=40

# Optional separate productivity model service. When empty the assistant reports
# productivity prediction as "currently unavailable".
PRODUCTIVITY_API_URL=

# Optional server-mediated TTS (provider URL). When empty the app uses on-device
# TTS / plain text responses.
AI_TTS_ENABLED=false
AI_TTS_BASE_URL=

# Public passport endpoint rate limit (requests/minute per client IP)
PASSPORT_RATE_LIMIT_PER_MINUTE=60