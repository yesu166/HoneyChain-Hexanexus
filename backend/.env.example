# HoneyChain HC-3.0 — FastAPI backend environment

# Runtime environment: development | production (production guards secret presence)
API_ENV=development

# Supabase PostgreSQL (system of record). Server-side ONLY. Never in Flutter.
SUPABASE_URL=https://hhxwhopaazqjdlreqhkf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT signing. Must be set (long random) in production; the app refuses to start
# in production without it.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma separated). Mobile apps do not need CORS; only web dashboards do.
CORS_ORIGINS=

# Ledger + AI adapters: simulated | fabric ; risk_engine | ai
BLOCKCHAIN_ADAPTER=simulated
AI_ADAPTER=risk_engine

# Public passport endpoint rate limit (requests/minute per client IP)
PASSPORT_RATE_LIMIT_PER_MINUTE=60