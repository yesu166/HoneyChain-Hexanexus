# ---------------------------------------------------------------------------
# HoneyChain web portal — environment template
#
# Copy to `.env.local` for local development. Anything prefixed VITE_ is
# embedded in the public JS bundle: NEVER put secrets, admin credentials,
# JWT secrets, or database passwords here.
# ---------------------------------------------------------------------------

# Base URL of the HoneyChain backend API.
#
# - Unset (default): same-origin. In `npm run dev` the Vite dev server proxies
#   /api and /predict-productivity to the addresses below (VITE_API_PROXY and
#   VITE_PRODUCTIVITY_API_PROXY), so a locally running HoneyChain backend on the
#   default ports just works with no configuration.
# - Production: set to the deployed HoneyChain API origin, e.g.
#   VITE_API_BASE_URL=https://api.honeychain.example
#   The backend must allow CORS from the portal's origin.
#VITE_API_BASE_URL=http://localhost:8000

# Dev-server proxy targets (development only — not used in production builds).
#VITE_API_PROXY=http://127.0.0.1:8001
#VITE_PRODUCTIVITY_API_PROXY=http://127.0.0.1:8000

# Public URL this portal is served from. Only needed when a printed QR must point
# at a host other than the one serving the build (e.g. a staging build printing
# labels for the production domain). Defaults to window.location.origin, which is
# correct for localhost, Vercel and Render.
#VITE_PUBLIC_APP_URL=https://portal.honeychain.example
