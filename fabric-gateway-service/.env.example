# HoneyChain Fabric Gateway — environment configuration
# Copy to .env on the EC2 instance and fill in real values.
# Never commit real values.

# Fabric peer connection
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Fabric identity (Org1 Admin MSP)
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=/root/honeychain/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem
FABRIC_KEY_PATH=/root/honeychain/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/

# TLS
FABRIC_TLS_CA_CERT_PATH=/root/honeychain/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt

# Channel and chaincode
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=honeychain

# Gateway service port
FABRIC_GATEWAY_PORT=9443
