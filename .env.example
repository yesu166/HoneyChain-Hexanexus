# HoneyChain — configuration (placeholders only; never commit real values)
# Copy to `.env` for local tooling, or pass to the app via --dart-define:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Direct PostgreSQL connection for applying versioned migrations via
# `node supabase/scripts/apply_migrations.js` (see README).
# Keep the password URL-encoded.
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD_AT@db.your-project-ref.supabase.co:5432/postgres

# ---- Backend (FastAPI) ----------------------------------------------------
# API_ENV=development            # development|production (prod disables /docs + tamper)
# JWT_SECRET=                    # required in production
# SUPABASE_SERVICE_ROLE_KEY=     # required to write to hosted Supabase
# SUPABASE_ANON_KEY=

# ---- Blockchain ledger selection (local | evm | fabric) -------------------
# BLOCKCHAIN_ADAPTER=local       # default dev/testing ledger (explicitly local)
# EVM (Polygon Amoy example):
# BLOCKCHAIN_ADAPTER=evm
# BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_CHAIN_ID=80002
# BLOCKCHAIN_CONTRACT=0x...
# BLOCKCHAIN_PRIVATE_KEY=        # NEVER commit
# Fabric:
# BLOCKCHAIN_ADAPTER=fabric
# FABRIC_CHANNEL=honeychain
# FABRIC_CHAINCODE=tracer

# ---- AI adapter -----------------------------------------------------------
# AI_ADAPTER=risk_engine         # rule-based, honest (no fabricated readings)